# Entorno
ENV=local

# Base de datos. Esta es la única variable de conexión que lee FastAPI, y
# el default apunta al PostgreSQL nativo de esta máquina (Camino B de
# README_LOCAL_SETUP.md). Con Docker no hace falta tocarla:
# docker-compose.yml arma la URL del contenedor con DB_USER, DB_PASSWORD y
# DB_NAME del .env de la raíz y pisa este valor.
#
# Si la contraseña tiene @ : / ? # o %, va percent-encoded.
DATABASE_URL=postgresql+psycopg://topgreen:CAMBIAR_PASSWORD_LOCAL_SEGURO_2026!@localhost:5432/topgreen

# Producción: cambiar cuando subas al servidor
# DATABASE_URL=postgresql+psycopg://USUARIO:PASSWORD@HOST:5432/topgreen

# JWT
JWT_SECRET=CAMBIAR_JWT_SECRET_MINIMO_32_CARACTERES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Aplicación
API_PREFIX=/api

# Uploads
# Carpeta donde se guardan las imágenes subidas. Un valor relativo se
# resuelve contra backend/, así que "uploads" es backend/uploads sin
# importar desde donde arranques uvicorn. Con Docker no se toca:
# docker-compose.yml la pisa con /data/uploads, que es el volumen
# persistente del contenedor.
UPLOAD_DIR=uploads
PUBLIC_UPLOAD_BASE=/uploads
MAX_UPLOAD_SIZE_MB=10

# Correo saliente.
# "outbox" escribe cada mensaje como un .eml en una carpeta local en vez
# de enviarlo. Es lo que usan el desarrollo y la suite: el archivo trae el
# enlace de confirmación real, así que no hace falta ningún endpoint de
# prueba que devuelva el token. La carpeta está ignorada por Git.
# "smtp" es el transporte productivo; ver backend/.env.production.example.
EMAIL_TRANSPORT=outbox
EMAIL_FROM=TopGreen <no-responder@topgreen.local>
EMAIL_OUTBOX_DIR=outbox

# CORS (para desarrollo local)
CORS_ORIGINS=["http://localhost:5173", "http://localhost"]

# ===========================================
# Mercado Pago - Marketplace (Split Payments)
# ===========================================
# DESVINCULADO: el proyecto se entrega sin credenciales de Mercado Pago.
# Completar con valores de la aplicación del nuevo equipo.
# Ver docs/SETUP_PAYMENTS.md
#
# Con estas cuatro vacías el vínculo con Mercado Pago queda apagado: el panel
# del vendedor lo dice y el resto del marketplace funciona igual, incluida la
# venta por transferencia.
MP_APP_ID=
MP_CLIENT_SECRET=
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
# A dónde vuelve el navegador después de que el vendedor autoriza. Tiene que
# ser una URL pública de esta API y estar declarada igual en la aplicación de
# Mercado Pago.
MP_REDIRECT_URI=

# Clave con la que se cifran las credenciales del vendedor antes de guardarlas.
# Es un secreto de operación: NO se versiona, NO se comparte y NO se rota sin
# avisar, porque rotarla invalida todos los vínculos y cada vendedor tiene que
# volver a conectar su cuenta. Se genera con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MP_TOKEN_KEY=

# Cobro por Mercado Pago. **Apagado.** Con esto en false el checkout no ofrece
# el medio, ninguna ruta crea preferencias y la venta por transferencia funciona
# igual. Se enciende recién cuando exista el webhook firmado, la consulta de
# estado a Mercado Pago y la política de stock: hasta entonces, cobrar de verdad
# sería prometer un pago que no podemos confirmar.
MP_CHECKOUT_HABILITADO=false

# A dónde avisa Mercado Pago cuando cambia un pago. Vacía hasta que exista el
# webhook: una URL que no atiende nadie sólo genera reintentos contra el vacío.
MP_NOTIFICACION_URL=

# Direcciones de Mercado Pago. Se dejan vacías: el código ya trae las buenas.
# Existen para que la prueba automatizada pueda apuntar a un doble local, del
# mismo modo que se apunta a otra base de datos.
# MP_AUTH_BASE_URL=https://auth.mercadopago.com.ar
# MP_API_BASE_URL=https://api.mercadopago.com

# Sólo la lee el módulo de cobro, que NO está montado. Queda como estaba: el
# valor que va a regir es cero —TopGreen no cobra comisión por venta— y esa
# corrección es parte de la pieza que monte el cobro, no de ésta.

# URLs públicas
NGROK_URL=
FRONTEND_URL=http://localhost:5173
