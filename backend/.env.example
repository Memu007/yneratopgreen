# Entorno
ENV=local

# Base de datos (Docker local - MSSQL Server)
DB_HOST=db
DB_PORT=1433
DB_NAME=topgreen
DB_USER=sa
DB_PASSWORD=CAMBIAR_PASSWORD_LOCAL
DATABASE_URL=mssql+pyodbc://sa:CAMBIAR_PASSWORD_LOCAL@db:1433/topgreen?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Base de datos (Producción - cambiar cuando subas al servidor)
# DATABASE_URL=mssql+pyodbc://sa:PASSWORD@IP_SERVIDOR:1433/topgreen?driver=ODBC+Driver+18+for+SQL+Server

# JWT
JWT_SECRET=CAMBIAR_JWT_SECRET_MINIMO_32_CARACTERES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Aplicación
BASE_URL=http://localhost
API_PREFIX=/api

# Uploads
UPLOAD_DIR=/data/uploads
PUBLIC_UPLOAD_BASE=/uploads
MAX_UPLOAD_SIZE_MB=10

# CORS (para desarrollo local)
CORS_ORIGINS=["http://localhost:5173", "http://localhost"]

# Admin inicial (seed)
ADMIN_EMAIL=admin@topgreen.com
ADMIN_PASSWORD=CAMBIAR_ADMIN_PASSWORD
ADMIN_NAME=Administrador TopGreen

# ===========================================
# Mercado Pago - Marketplace (Split Payments)
# ===========================================
# DESVINCULADO: el proyecto se entrega sin credenciales de Mercado Pago.
# Completar con valores de la aplicación del nuevo equipo.
# Ver docs/SETUP_PAYMENTS.md
MP_APP_ID=
MP_CLIENT_SECRET=
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_REDIRECT_URI=
MP_COMMISSION_PERCENT=5.0

# URLs públicas
NGROK_URL=
FRONTEND_URL=http://localhost:5173
