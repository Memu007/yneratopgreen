# ===========================================
# TopGreen - Configuración de Producción
# ===========================================
# Esta es una plantilla de referencia y FastAPI NO la lee por su nombre:
# Settings carga automáticamente backend/.env y ningún otro archivo.
#
# - En un servidor propio: copiar estas claves, ya con sus valores reales, a
#   backend/.env.
# - En Railway: cargar cada clave como variable de entorno del servicio. No se
#   sube ningún archivo ni se renombra esta plantilla. Ver RAILWAY.md.
#
# Sólo van claves que Settings declara. Una clave de más hace fallar el
# arranque con extra_forbidden.
# ===========================================

# Entorno
ENV=production

# Base de datos. Única variable de conexión que lee FastAPI; las credenciales
# del motor las administra quien despliega. En Railway la provee el servicio
# de PostGIS. Si la contraseña tiene @ : / ? # o %, va percent-encoded.
DATABASE_URL=postgresql+psycopg://CAMBIAR_USUARIO:CAMBIAR_PASSWORD_SEGURO_EN_PRODUCCION@CAMBIAR_HOST:5432/topgreen

# JWT - CAMBIAR EN PRODUCCIÓN
JWT_SECRET=GENERAR_SECRET_SEGURO_32_CHARS_MINIMO
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Aplicación
API_PREFIX=/api

# Uploads. Conviene una ruta absoluta y escribible por el proceso; una
# relativa se resuelve contra backend/.
UPLOAD_DIR=/data/uploads
PUBLIC_UPLOAD_BASE=/uploads
MAX_UPLOAD_SIZE_MB=10

# CORS - Dominios permitidos en producción (completar con el dominio real)
CORS_ORIGINS=[]

# ===========================================
# Correo saliente
# ===========================================
# En producción el transporte es SMTP. La contraseña es un secreto: va en
# el entorno del servicio, nunca en el repositorio.
EMAIL_TRANSPORT=smtp
EMAIL_FROM=TopGreen <no-responder@CAMBIAR_DOMINIO>
EMAIL_OUTBOX_DIR=outbox
SMTP_HOST=CAMBIAR_HOST_SMTP
SMTP_PORT=587
SMTP_USER=CAMBIAR_USUARIO_SMTP
SMTP_PASSWORD=CAMBIAR_PASSWORD_SMTP
SMTP_TLS=true

# FRONTEND_URL arma el enlace de confirmación que recibe la persona, así
# que tiene que ser el dominio público real.

# ===========================================
# Mercado Pago - Marketplace (Split Payments)
# ===========================================
# DESVINCULADO: el proyecto se entrega sin credenciales de Mercado Pago.
# El nuevo equipo técnico debe completar estos valores usando su propia
# aplicación de Mercado Pago (https://www.mercadopago.com.ar/developers).
# Ver docs/SETUP_PAYMENTS.md para el detalle del flujo y cómo reactivar.
MP_APP_ID=
MP_CLIENT_SECRET=
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=

# URI para OAuth de vendedores: completar con el dominio público real.
# Tiene que ser un host al que el navegador le mande la sesión del vendedor:
# si no, todos los intentos terminan en «se cerró tu sesión durante la conexión».
MP_REDIRECT_URI=

# Clave con la que se cifran las credenciales de los vendedores. Va en el
# gestor de secretos del entorno, NO acá. Rotarla invalida todos los vínculos y
# obliga a cada vendedor a reconectar, así que se avisa antes.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MP_TOKEN_KEY=

# Cobro por Mercado Pago. **Apagado en producción.** Vincular la cuenta de un
# vendedor no mueve dinero y puede quedar habilitado; cobrar sí, y todavía no
# hay webhook firmado, consulta de estado ni política de stock. Encenderlo
# antes sería prometer un pago que no podemos confirmar.
MP_CHECKOUT_HABILITADO=false
MP_NOTIFICACION_URL=

# ===========================================
# Dominios públicos (configurar con los del nuevo deploy)
# ===========================================
# Si se usa ngrok como reverse proxy en producción/staging, crear el dominio en
# https://dashboard.ngrok.com/domains y completar acá. Si no, dejar vacío.
NGROK_URL=
FRONTEND_URL=
